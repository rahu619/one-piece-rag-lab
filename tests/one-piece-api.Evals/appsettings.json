{
    "Ollama": {
        "BaseUrl": "http://localhost:11434",
        "ModelId": "qwen2.5-coder:1.5b",
        "EmbeddingModelId": "nomic-embed-text"
    },
    "Ingestion": {
        "RunOnStart": false,
        "CsvFilePath": "Data/one_piece_episodes.csv"
    },
    "SemanticCache": {
        "Enabled": false,
        "SimilarityThreshold": 0.95,
        "CollectionName": "one_piece_cache"
    },
