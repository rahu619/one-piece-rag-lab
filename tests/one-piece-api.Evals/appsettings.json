        "Enabled": true,
        "MaxQueryLength": 2000,
        "BlockPromptInjection": true,
        "BlockPii": true,
        "BlockHarmfulContent": true,
        "RedactPiiInTraces": true
    },
    "Observability": {
        "Enabled": true,
        "TraceDirectory": "observability",
        "LogPrompts": true
    }
}
